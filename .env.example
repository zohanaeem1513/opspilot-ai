# OpsPilot AI — example environment variables
#
# This file documents every environment variable the project is expected to
# need across all planned phases. NONE of the values below are real —
# copy this file to .env (backend) and/or apps/web/.env.local (frontend) and
# fill in your own values once each phase actually introduces that integration.
#
# Never commit a real .env file — .gitignore already excludes .env*.local files.

# --- General ---
ENVIRONMENT=development                  # development | production

# --- Backend (apps/api) — introduced in Phase 1 ---
APP_NAME=opspilot-api                     # service name returned by GET /health
APP_VERSION=0.1.0                         # version returned by GET /health
DEBUG=true                                # backend debug mode (non-secret)

# --- Backend (apps/api) — introduced in Phase 3+ ---
# Supabase Postgres connection string, accessed directly via SQLAlchemy's
# async engine (asyncpg driver) — not the Supabase Python client. Server-side
# only; never sent to apps/web or exposed to browser JavaScript.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# --- Backend (apps/api) — Supabase Auth JWT verification, introduced in Phase 3B ---
# Exactly ONE of the next two is expected to be set, depending on which
# signing algorithm your Supabase project actually uses (Supabase dashboard:
# Settings -> API -> JWT Settings). Both are server-only, never sent to
# apps/web or exposed to browser JavaScript. No Supabase SDK/service-role key
# is used to verify tokens — see apps/api/app/core/security.py.
SUPABASE_JWT_SECRET=replace-with-your-projects-jwt-secret   # only if your project uses HS256 (legacy shared secret)
SUPABASE_URL=https://your-project.supabase.co                # only if your project uses asymmetric signing (fetches its public JWKS)
# Required whenever either of the above is set — the expected "iss" claim on
# Supabase-issued access tokens.
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1

# --- Backend (apps/api) — Supabase Storage, introduced in Phase 4 ---
# Document files are stored in a private Supabase Storage bucket. The
# backend calls Supabase's Storage REST API directly via httpx (no Storage
# SDK), using SUPABASE_URL (above) as the API host. Because this project
# does not configure Storage RLS policies (matching the FastAPI-layer-only
# authorization already used for the database — see docs/DATABASE.md),
# writes require the service_role key, not the anon key. This is the most
# powerful Supabase key there is; its use here is deliberately narrow (only
# apps/api/app/core/storage.py touches it) — see docs/DECISIONS.md. Server-
# side only, never sent to apps/web.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-projects-service-role-key
SUPABASE_STORAGE_BUCKET=documents           # must exist as a private bucket in your Supabase project

# --- AI providers — introduced in Phase 6+ ---
AI_PROVIDER=ollama                        # ollama | gemini
GEMINI_API_KEY=replace-with-your-gemini-key
OLLAMA_BASE_URL=http://localhost:11434

# --- Frontend (apps/web) — introduced in Phase 2+ ---
# Read only on the server (Next.js Server Components) — never exposed to
# browser JavaScript, so it is NOT prefixed with NEXT_PUBLIC_. The code
# already defaults to http://127.0.0.1:8000 if this is unset, so setting it
# is optional for local development. To override locally, create
# apps/web/.env.local (git-ignored, never committed) with your own value.
API_BASE_URL=http://127.0.0.1:8000

# --- Frontend (apps/web) — Supabase Auth, introduced in Phase 3B ---
# Browser-safe: read by the Supabase JS client in both server and client
# components. The anon key is not a secret — Supabase's own access rules
# constrain what it can do — but it still only belongs in
# apps/web/.env.local (git-ignored), never committed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key
