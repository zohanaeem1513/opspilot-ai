# OpsPilot AI — example environment variables
#
# This file documents every environment variable the project is expected to
# need across all planned phases. NONE of the values below are real —
# copy this file to .env (backend) and/or apps/web/.env.local (frontend) and
# fill in your own values once each phase actually introduces that integration.
#
# Never commit a real .env file — .gitignore already excludes .env*.local files.

# --- General ---
ENVIRONMENT=development                  # development | production

# --- Backend (apps/api) — introduced in Phase 1 ---
APP_NAME=opspilot-api                     # service name returned by GET /health
APP_VERSION=0.1.0                         # version returned by GET /health
DEBUG=true                                # backend debug mode (non-secret)

# --- Backend (apps/api) — introduced in Phase 3+ ---
DATABASE_URL=postgresql://user:password@host:5432/opspilot   # Neon Postgres connection string
JWT_SECRET=replace-with-a-random-secret                       # only if not using Supabase Auth

# --- Supabase (auth / storage) — introduced in Phase 3+ ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key   # backend only, never expose to frontend

# --- AI providers — introduced in Phase 6+ ---
AI_PROVIDER=ollama                        # ollama | gemini
GEMINI_API_KEY=replace-with-your-gemini-key
OLLAMA_BASE_URL=http://localhost:11434

# --- Frontend (apps/web) — introduced in Phase 2+ ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
