# OpsPilot AI — example environment variables
#
# This file documents every environment variable the project is expected to
# need across all planned phases. NONE of the values below are real —
# copy this file to .env (backend) and/or apps/web/.env.local (frontend) and
# fill in your own values once each phase actually introduces that integration.
#
# Never commit a real .env file — .gitignore already excludes .env*.local files.

# --- General ---
ENVIRONMENT=development                  # development | production

# --- Backend (apps/api) — introduced in Phase 1 ---
APP_NAME=opspilot-api                    # service name returned by GET /health
APP_VERSION=0.1.0                        # version returned by GET /health
DEBUG=true                               # backend debug mode (non-secret)

# --- Backend (apps/api) — Supabase Postgres, introduced in Phase 3A ---
# Supabase Postgres connection string, accessed directly via SQLAlchemy's
# async engine (asyncpg driver) — not the Supabase Python client. Server-side
# only; never sent to apps/web or exposed to browser JavaScript.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# --- Backend (apps/api) — Supabase Auth JWT verification, introduced in Phase 3B ---
# SUPABASE_URL is required by the project because it is also used by the
# Supabase Storage integration introduced in Phase 4.
#
# For JWT verification:
# - Set SUPABASE_JWT_SECRET if the project uses legacy HS256 signing.
# - Otherwise the backend uses SUPABASE_URL to fetch the project's public JWKS
#   for asymmetric signing (RS256/ES256).
#
# These values are server-side only and are never exposed to browser JavaScript.
SUPABASE_JWT_SECRET=replace-with-your-projects-jwt-secret   # required only for HS256 JWT verification
SUPABASE_URL=https://your-project.supabase.co               # also required by Supabase Storage

# Expected "iss" claim on Supabase-issued access tokens.
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1

# --- Backend (apps/api) — Supabase Storage, introduced in Phase 4 ---
# Document files are stored in a private Supabase Storage bucket. The backend
# calls Supabase's Storage REST API directly via httpx (no Storage SDK), using
# SUPABASE_URL above as the API host.
#
# Because this project does not configure Storage RLS policies (matching the
# FastAPI-layer-only authorization already used for the database — see
# docs/DATABASE.md), Storage operations use the service_role key rather than
# the anon key.
#
# This is the most powerful Supabase key; its use is deliberately restricted
# to apps/api/app/core/storage.py. It is server-side only and is never sent to
# apps/web.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-projects-service-role-key
SUPABASE_STORAGE_BUCKET=documents        # must exist as a private bucket in the Supabase project

# --- Document embeddings — introduced in Phase 5 ---
# Embeddings are generated locally with Sentence Transformers using
# all-MiniLM-L6-v2 and stored in PostgreSQL/pgvector as 384-dimensional vectors.
# No API key or additional environment variable is required for Phase 5.

# --- AI providers — introduced in Phase 6+ ---
AI_PROVIDER=ollama                       # ollama | gemini
GEMINI_API_KEY=replace-with-your-gemini-key
OLLAMA_BASE_URL=http://localhost:11434

# --- Frontend (apps/web) — introduced in Phase 2+ ---
# Read only on the server (Next.js Server Components / Server Actions) — never
# exposed to browser JavaScript, so it is NOT prefixed with NEXT_PUBLIC_.
# The code defaults to http://127.0.0.1:8000 if this is unset, so setting it
# is optional for local development.
#
# To override locally, create apps/web/.env.local (git-ignored, never committed)
# with your own value.
API_BASE_URL=http://127.0.0.1:8000

# --- Frontend (apps/web) — Supabase Auth, introduced in Phase 3B ---
# Browser-safe values used by the Supabase JS client in server and client
# components. The anon key is not treated like a server secret; Supabase's
# access rules constrain what it can do.
#
# Real values belong in apps/web/.env.local (git-ignored), not in this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key